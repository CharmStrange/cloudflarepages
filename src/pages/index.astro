---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);
---
<Base>
  <h1>안녕하세요!</h1>
  <p>CloudFlare 로 웹 페이지 뚝딱! 만들어 봤습니다. 개인 블로그 용도로 개설했어요~</p>
  <h2>최근 글</h2>
  <ul class="list">
    {posts.map((p) => (
      <li><time>{p.data.date.toISOString().slice(0, 10)}</time><a href={`/blog/${p.id}/`}>{p.data.title}</a></li>
    ))}
  </ul>
</Base>
