---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => a.data.date.getTime() - b.data.date.getTime());
---
<Base>
  <h1>안녕하세요!</h1>
  <p>블로그용 개인 홈페이지입니다.</p>
  <h2>최근 글</h2>
  <ul class="list" id="post-list">
    {posts.map((p) => (
      <li><time>{p.data.date.toISOString().slice(0, 10)}</time><a href={`/blog/${p.id}/`}>{p.data.title}</a></li>
    ))}
  </ul>

  <div class="pager" id="pager">
    <button type="button" id="prev">← 이전 목록</button>
    <span id="page-info"></span>
    <button type="button" id="next">다음 목록 →</button>
  </div>
</Base>

<style>
  .pager { display: none; justify-content: space-between; align-items: center; margin-top: 1.5rem; }
  .pager button { padding: 0.4rem 0.8rem; cursor: pointer; }
  .pager button:disabled { opacity: 0.35; cursor: default; }
</style>

<script>
  const SIZE = 5; // 한 번에 보여줄 글 수
  const items = Array.from(document.querySelectorAll<HTMLElement>('#post-list li'));
  const pager = document.getElementById('pager') as HTMLElement;
  const prev = document.getElementById('prev') as HTMLButtonElement;
  const next = document.getElementById('next') as HTMLButtonElement;
  const info = document.getElementById('page-info') as HTMLElement;

  const last = Math.max(0, Math.ceil(items.length / SIZE) - 1);
  let page = 0;

  function show() {
    items.forEach((li, i) => {
      li.style.display = Math.floor(i / SIZE) === page ? '' : 'none';
    });
    prev.disabled = page === 0;
    next.disabled = page === last;
    info.textContent = `${page + 1} / ${last + 1}`;
  }

  prev.addEventListener('click', () => { page--; show(); });
  next.addEventListener('click', () => { page++; show(); });

  if (items.length > SIZE) pager.style.display = 'flex';
  show();
</script>
